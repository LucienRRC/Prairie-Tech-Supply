<%= render "shared/page_hero",
  eyebrow: "SHOP BY DEPARTMENT",
  title: "Categories",
  description: "Browse every available product in a department without running a keyword search.",
  hero_class: "category-hero" %>

<section class="container section">
  <div class="category-grid">
    <% @categories.each do |category| %>
      <article class="category-card">
        <div>
          <p class="category-count"><%= pluralize(@product_counts.fetch(category.id, 0), "product") %></p>
          <h2><%= category.name %></h2>
          <p><%= category.description.presence || "Explore available #{category.name.downcase} products." %></p>
        </div>
        <%= link_to "Browse #{category.name}", category_path(category), class: "category-link" %>
      </article>
    <% end %>
  </div>

  <% if @categories.empty? %>
    <%= render "shared/empty_state",
      title: "No categories available",
      description: "Categories will appear here when active products are added." %>
  <% end %>
</section>
