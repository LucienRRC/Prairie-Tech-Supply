<%= render "shared/page_hero",
  eyebrow: "ALL CATEGORIES",
  eyebrow_path: categories_path,
  title: @category.name,
  description: @category.description.presence || "Browse all available products in #{@category.name}.",
  hero_class: "category-hero" %>

<section class="container section">
  <div class="category-toolbar">
    <p><strong><%= pluralize(@products.total_count, "available product") %></strong></p>
    <%= link_to "Back to categories", categories_path %>
  </div>

  <%= render "shared/product_grid", products: @products %>

  <% if @products.empty? %>
    <%= render "shared/empty_state",
      title: "No available products",
      description: "This category does not currently contain active products.",
      link_text: "Browse other categories",
      link_path: categories_path %>
  <% elsif @products.total_pages > 1 %>
    <div class="pagination-wrap">
      <%= paginate @products %>
    </div>
  <% end %>
</section>
