<section class="page-hero">
  <div class="container">
    <p class="eyebrow">SECURE CHECKOUT</p>
    <h1>Customer details</h1>
    <p>Choose your province so the invoice uses the correct Canadian sales taxes.</p>
    <ol class="checkout-steps" aria-label="Checkout progress">
      <li class="is-complete"><span>1</span>Cart</li>
      <li class="is-current" aria-current="step"><span>2</span>Details</li>
      <li><span>3</span>Invoice</li>
    </ol>
  </div>
</section>

<section class="container section checkout-layout">
  <div class="checkout-form-panel">
    <h2>Contact and address</h2>
    <p class="form-note">Province is required. Street address, city, and postal code may be left blank for in-store pickup.</p>

    <%= form_with model: @customer, url: checkout_path, method: :post, class: "checkout-form" do |form| %>
      <% if @customer.errors.any? %>
        <div class="form-errors" role="alert">
          <strong>Please correct the following:</strong>
          <ul>
            <% @customer.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="checkout-fields two-column-fields">
        <div>
          <%= form.label :first_name %>
          <%= form.text_field :first_name, required: true, autocomplete: "given-name" %>
        </div>
        <div>
          <%= form.label :last_name %>
          <%= form.text_field :last_name, required: true, autocomplete: "family-name" %>
        </div>
        <div>
          <%= form.label :email %>
          <%= form.email_field :email,
            required: true,
            autocomplete: "email",
            pattern: "[^\\s@]+@[^\\s@]+\\.[A-Za-z]{2,63}",
            title: "Enter a complete email address, such as name@example.com",
            readonly: customer_signed_in? %>
        </div>
        <div>
          <%= form.label :phone %>
          <%= form.telephone_field :phone, autocomplete: "tel" %>
        </div>
      </div>

      <div class="checkout-fields">
        <div>
          <%= form.label :province_id, "Province or territory" %>
          <% province_options = @provinces.map { |province|
            [province.name, province.id, {
              "data-gst-rate": province.gst_rate,
              "data-pst-rate": province.pst_rate,
              "data-hst-rate": province.hst_rate
            }]
          } %>
          <%= form.select :province_id,
            options_for_select(province_options, @customer.province_id),
            { prompt: "Select a province or territory" },
            { required: true, autocomplete: "address-level1", data: { checkout_province: true } } %>
        </div>
        <div>
          <%= form.label :address, "Street address (optional)" %>
          <%= form.text_field :address, autocomplete: "address-line1" %>
        </div>
      </div>

      <div class="checkout-fields two-column-fields">
        <div>
          <%= form.label :city %>
          <%= form.text_field :city, autocomplete: "address-level2" %>
        </div>
        <div>
          <%= form.label :postal_code %>
          <%= form.text_field :postal_code, autocomplete: "postal-code" %>
        </div>
      </div>

      <% if Rails.application.config.x.stripe.checkout_enabled %>
        <%= form.submit "Continue to secure card payment", class: "checkout-submit" %>
        <p class="form-note">Card details are collected securely by Stripe and are never stored on this website.</p>
      <% else %>
        <%= form.submit "Place order and view invoice", class: "checkout-submit" %>
        <p class="form-note">Your order will be created as New. Store staff can update its status after reviewing it.</p>
      <% end %>
    <% end %>
  </div>

  <aside class="checkout-review" data-checkout-review data-subtotal="<%= @subtotal %>">
    <h2>Order review</h2>
    <% @checkout_items.each do |item| %>
      <div class="checkout-review-item">
        <div>
          <strong><%= item[:product].name %></strong>
          <span><%= item[:quantity] %> &times; <%= number_to_currency(item[:product].selling_price) %></span>
        </div>
        <strong><%= number_to_currency(item[:line_total]) %></strong>
      </div>
    <% end %>
    <div class="checkout-review-total checkout-subtotal">
      <span>Subtotal before tax</span>
      <strong data-checkout-subtotal><%= number_to_currency(@subtotal) %></strong>
    </div>
    <div class="checkout-tax-breakdown" data-checkout-tax-breakdown hidden>
      <div data-tax-row="gst" hidden>
        <span>GST <small data-tax-rate="gst"></small></span>
        <strong data-tax-amount="gst">$0.00</strong>
      </div>
      <div data-tax-row="pst" hidden>
        <span>PST <small data-tax-rate="pst"></small></span>
        <strong data-tax-amount="pst">$0.00</strong>
      </div>
      <div data-tax-row="hst" hidden>
        <span>HST <small data-tax-rate="hst"></small></span>
        <strong data-tax-amount="hst">$0.00</strong>
      </div>
      <div class="checkout-estimated-total">
        <span>Estimated total</span>
        <strong data-checkout-total><%= number_to_currency(@subtotal) %></strong>
      </div>
    </div>
    <p data-tax-prompt>Choose a province or territory to preview GST, PST, HST, and the estimated total.</p>
    <div class="checkout-security">
      <strong>Your order is protected</strong>
      <span>Address details are used only to complete and fulfill your order.</span>
    </div>
  </aside>
</section>
