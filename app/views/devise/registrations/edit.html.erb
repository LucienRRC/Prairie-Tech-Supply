<section class="page-hero auth-hero">
  <div class="container narrow">
    <p class="eyebrow">CUSTOMER ACCOUNT</p>
    <h1>Edit account</h1>
    <p>Update your saved contact and address details.</p>
  </div>
</section>

<section class="container narrow section">
  <div class="auth-panel">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
      html: { method: :put, class: "auth-form" }) do |form| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="auth-fields two-column-fields">
        <div><%= form.label :first_name %><%= form.text_field :first_name, required: true %></div>
        <div><%= form.label :last_name %><%= form.text_field :last_name, required: true %></div>
      </div>
      <div class="auth-fields">
        <div><%= form.label :username %><%= form.text_field :username, required: true, autocomplete: "username" %></div>
        <div><%= form.label :email %><%= form.email_field :email, required: true, autocomplete: "email" %></div>
        <div>
          <%= form.label :province_id, "Province or territory" %>
          <%= form.collection_select :province_id, Province.order(:name), :id, :name, {}, required: true %>
        </div>
        <div><%= form.label :address %><%= form.text_field :address, autocomplete: "street-address" %></div>
      </div>
      <div class="auth-fields two-column-fields">
        <div><%= form.label :city %><%= form.text_field :city %></div>
        <div><%= form.label :postal_code %><%= form.text_field :postal_code %></div>
      </div>
      <div class="auth-fields two-column-fields">
        <div>
          <%= form.label :password, "New password (optional)" %>
          <%= form.password_field :password, autocomplete: "new-password" %>
        </div>
        <div>
          <%= form.label :password_confirmation %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
        </div>
      </div>
      <div class="auth-fields">
        <div>
          <%= form.label :current_password, "Current password (required to save)" %>
          <%= form.password_field :current_password, required: true, autocomplete: "current-password" %>
        </div>
      </div>

      <%= form.submit "Save account", class: "auth-submit" %>
    <% end %>
  </div>
</section>
